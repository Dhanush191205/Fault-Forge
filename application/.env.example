# Copy to .env. Keep real secrets out of source control.
ENVIRONMENT=development
DEMO_MODE=true
DATABASE_URL=sqlite:///./faultforge.db
RAG_BACKEND=fixture
LLM_PROVIDER=fixture
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=
LLM_API_KEY=
EMBEDDING_BASE_URL=https://integrate.api.nvidia.com/v1
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_SSL=false
CHROMA_TOKEN=
CHROMA_COLLECTION=faultforge_v1
RETRIEVAL_MAX_DISTANCE=0.45
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
SECURE_COOKIES=false
GENERATOR_VERSION=grounded-selector/1.0.0
INSTRUCTOR_EMAIL=instructor@faultforge.local
INSTRUCTOR_PASSWORD=
TRAINEE_EMAIL=trainee@faultforge.local
TRAINEE_PASSWORD=
# Compose only: choose an independent database password.
POSTGRES_PASSWORD=
